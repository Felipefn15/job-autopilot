{
  "name": "job-autopilot-cloud",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "vite build",
    "test": "node --test test/*.test.js",
    "check": "npm run build && wrangler deploy --dry-run",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler deploy",
    "prebuild": "node scripts/workspace-schema.mjs",
    "pretest": "node scripts/workspace-schema.mjs"
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "prettier": "^3.9.7",
    "vite": "^8.3.0",
    "wrangler": "^4.133.0"
  }
}
