{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "job-autopilot",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "job-autopilot",
      "database_id": "760bc391-0533-4b7a-a9f1-117c54cfec74",
      "migrations_dir": "migrations",
    },
  ],
  "browser": { "binding": "BROWSER" },
  "durable_objects": {
    "bindings": [{ "name": "LINKEDIN_CLOUD", "class_name": "LinkedInCloud" }],
  },
  "migrations": [
    { "tag": "v1-linkedin-cloud", "new_sqlite_classes": ["LinkedInCloud"] },
  ],
  "triggers": { "crons": ["17 */2 * * *"] },
  "vars": {
    "GEMINI_MODEL": "gemini-2.5-flash",
    "GROQ_MODEL": "llama-3.3-70b-versatile",
    "DAILY_AI_LIMIT": "30",
    "DAILY_APPLICATION_LIMIT": "3",
    "DAILY_BROWSER_LIMIT": "3",
  },
  "observability": { "enabled": false },
}
