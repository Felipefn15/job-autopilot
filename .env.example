# AI API Keys (Groq primary for scoring; Gemini fallback)
GEMINI_API_KEY=your_gemini_key
GROQ_API_KEY=your_groq_key

# Gmail SMTP (smtplib; porta 587, starttls)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
FROM_EMAIL=your_email@gmail.com

# Optional: dry run (no emails sent)
# DRY_RUN=False

# Optional: SerpAPI (Google Dorks Sniper – 1ª iteração)
# SERPAPI_KEY=your_serpapi_key

# Optional: LinkedIn (post search / easy apply)
# LINKEDIN_EMAIL=
# LINKEDIN_PASSWORD=

# Persistent deployment paths
DATA_DIR=/data
BROWSER_PROFILE_DIR=/data/playwright_profile
DATABASE_PATH=jobs.db
LOG_DIR=logs
RESULTS_PATH=/data/application_results.json

# User data can be supplied without committing user_config.json
USER_NAME=Your Name
USER_EMAIL=your_email@gmail.com
USER_PHONE=+55 21 99999-9999
USER_LINKEDIN=https://www.linkedin.com/in/your-profile

# Scheduled execution defaults (used by docker-compose.yml)
JOB_LOCATION=Latam
MAX_APPLICATIONS=5
MIN_SCORE=0.3

